# ══════════════════════════════════════════
# Environment
# ══════════════════════════════════════════
# "development" | "production"
ENV=development

# ══════════════════════════════════════════
# Database
# ══════════════════════════════════════════
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net
# DB_NAME=doclens   # optional, defaults to "doclens"

# ══════════════════════════════════════════
# Email (Brevo — https://app.brevo.com)
# ══════════════════════════════════════════
BREVO_API_KEY=your-brevo-api-key
SENDER_EMAIL=noreply@yourdomain.com
SENDER_NAME="Doc Lens"

# ══════════════════════════════════════════
# AI / LLM providers
# ══════════════════════════════════════════
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
NVIDIA_API_KEY=your-nvidia-api-key

# ══════════════════════════════════════════
# Auth — JWT & Session
# ══════════════════════════════════════════
# Generate strong random secrets, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret
SESSION_SECRET_KEY=change-me-to-a-different-random-secret

# ══════════════════════════════════════════
# OAuth — Google (https://console.cloud.google.com)
# ══════════════════════════════════════════
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ══════════════════════════════════════════
# OAuth — GitHub (https://github.com/settings/developers)
# ══════════════════════════════════════════
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# ══════════════════════════════════════════
# Storage (Cloudinary — https://cloudinary.com)
# ══════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ══════════════════════════════════════════
# Vector store (Chroma Cloud — https://trychroma.com)
# ══════════════════════════════════════════
CHROMA_API_KEY=your-chroma-cloud-api-key
CHROMA_TENANT=your-tenant-id
CHROMA_DATABASE=your-database-name

# ══════════════════════════════════════════
# Frontend / CORS
# ══════════════════════════════════════════
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=*